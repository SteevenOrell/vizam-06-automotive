# ORVANE (vizam-06-automotive) environment variables. Names only; never commit values.
# The site has no backend, database, analytics or third-party runtime services.

# Public origin used for Open Graph / canonical URLs (metadataBase). Optional: defaults to http://localhost:3006.
# Set it per deployment, e.g. to the Vercel preview or production URL.
NEXT_PUBLIC_SITE_URL=
